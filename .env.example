# Copia este archivo como .env y completa los valores
# JWT_SECRET: clave aleatoria de al menos 32 caracteres. La API no inicia con este
# valor de ejemplo. Para generar una: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=escribe-aqui-una-clave-larga-y-aleatoria
PORT_POSTGRES=15433
PORT_BACKEND=4451
PORT_FRONTEND=3351
COMPOSE_PROJECT_NAME=atlas-et
